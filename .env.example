# ============================================================================
# TradeBot v5 (TB5) — template de configurare
# Copiaza acest fisier in .env si completeaza valorile.
# .env este gitignored. NU commit-a niciodata valori reale aici.
# ============================================================================

# --- Securitate API ---------------------------------------------------------
# Token pentru rutele de control: kill switch, mod executie, credinte, grid,
# agent AI, reset cont paper. Se trimite ca header `x-bot-token` sau
# `Authorization: Bearer <token>`.
# Generare: openssl rand -hex 24
# Daca lipseste si NODE_ENV=production, serverul genereaza un token aleator la
# fiecare pornire (il afiseaza in log la boot) — seteaza-l explicit pe server.
BOT_CONTROL_TOKEN=""

# --- OKX EEA ----------------------------------------------------------------
# Optionale: aceleasi valori se pot salva din UI (tab 5: Conexiune OKX EEA).
# Chei recomandate: fara permisiune de withdraw + IP whitelist.
OKX_API_KEY=""
OKX_SECRET_KEY=""
OKX_PASSPHRASE=""

# --- DeepSeek Agent AI ------------------------------------------------------
# https://platform.deepseek.com
# Optionale: cheia se poate salva si din UI (tab 5 "Configurare API DeepSeek"
# sau tab 8 "DeepSeek Agent"). Fara cheie, agentul ruleaza pe fallback
# determinist LOCAL_FALLBACK (fara LLM).
DEEPSEEK_API_KEY=""

# --- Telegram (optional) ----------------------------------------------------
# Bot creat cu @BotFather. Chat ID se auto-împerecheaza la primul mesaj.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# --- Runtime ----------------------------------------------------------------
# production = token de control obligatoriu, fara token public de dev
NODE_ENV=""
